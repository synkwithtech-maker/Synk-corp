# Application Settings
APP_NAME="Synk Corp Support API"
APP_VERSION="2.1.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
TEMPERATURE=0.0
MAX_TOKENS=1000

# Qdrant
EMBEDDING_MODEL_NAME=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=synk_company_docs
TOP_K_DOCUMENTS=4

# Redis
REDIS_ENABLED=True
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=synk:chat:session
REDIS_TTL_SECONDS=86400
MAX_HISTORY_TURNS=6

# Guardrails
GUARDRAILS_ENABLED=True
GUARDRAIL_BLOCK_PROMPT_INJECTION=True
GUARDRAIL_MASK_PII=True
GUARDRAIL_STRICT_GROUNDING=True
