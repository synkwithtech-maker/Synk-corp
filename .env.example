# ==============================================================================
# Synk Corp Support Chatbot Configuration Template
# Copy this file to .env and fill in your keys.
# ==============================================================================

# Application Environment
APP_NAME="Synk Corp Support API"
APP_VERSION="2.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# OpenRouter / LLM Configuration
# Sign up at https://openrouter.ai to obtain an API key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TEMPERATURE=0.0
MAX_TOKENS=1000

# Optional Direct OpenAI API Key Fallback
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Embedding & Vector Database Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=synk_company_docs
TOP_K_DOCUMENTS=4

# Redis Conversation Memory Configuration
REDIS_ENABLED=True
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400
MAX_HISTORY_TURNS=6
